---
import type { FaqItem, InternalLinkItem } from "../data/prestations-seo";
import { CMS_SLUG_BY_PATH } from "../data/cms-pages";
import { isPageHidden } from "../data/content";

interface Props {
  faqItems: FaqItem[];
  internalLinks: InternalLinkItem[];
}

const { faqItems = [], internalLinks = [] } = Astro.props;

// Un lien vers une page masquée la rendrait découvrable malgré le noindex,
// et proposerait au visiteur une page que l'on ne veut pas encore montrer.
const visibleLinks = (
  await Promise.all(
    internalLinks.map(async (item) => {
      const slug = CMS_SLUG_BY_PATH[item.href];
      return slug && (await isPageHidden(slug)) ? null : item;
    }),
  )
).filter((item): item is InternalLinkItem => item !== null);
---

{
  faqItems.length > 0 && (
    <section class="prestation-seo-block" aria-label="Questions fréquentes">
      <h2>Questions fréquentes</h2>
      <div class="prestation-faq-grid">
        {
          faqItems.map((item) => (
            <article class="prestation-faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))
        }
      </div>
    </section>
  )
}

{
  visibleLinks.length > 0 && (
    <nav class="prestation-seo-block prestation-links" aria-label="Autres accompagnements">
      <h2>Autres accompagnements</h2>
      <ul>
        {
          visibleLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  )
}
