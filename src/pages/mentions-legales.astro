---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageContent } from "../data/content";
import { getDefaultPageSeo } from "../data/seo";

const slug = "mentions-legales";
const page = await getPageContent(slug);
const defaultSeo = getDefaultPageSeo("/mentions-legales");
const title = page.seoTitle?.trim() || defaultSeo.title;
const description = page.seoDescription?.trim() || defaultSeo.description;
const keywords = page.seoKeywords?.trim() || defaultSeo.keywords;
const ogImage = page.seoOgImage?.trim() || undefined;
const noindex = page.seoNoindex ?? false;
const html = page.html;
---

<BaseLayout title={title} description={description} keywords={keywords} ogImage={ogImage} noindex={noindex}>
  <article class="section wp-content legal-page" aria-labelledby="page-title">
    <h1 id="page-title">{page.title}</h1>
    <div set:html={html}></div>
  </article>
</BaseLayout>
